# Godot
.godot/
export/
# Tools and addons cloned by `make setup`
.tools
game/addons/gdUnit4
# Test reports (keep .gitkeep)
game/test/reports/*.xml
game/test/reports/*.json
game/test/reports/*.html
game/test/reports/*/
game/test/reports/test_output.log
game/test/reports/log_warnings.txt
game/test/reports/test_exit
# gdUnit4 default report dir when run outside `make test` (e.g. single suite from CLI)
game/reports/
# Secrets
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
secrets/
*service-account*.json
google-services.json
.env
# Python
__pycache__/
*.pyc
# OS
.DS_Store
# Godot CSV import artifacts (Locale loads the CSV itself)
game/locale/*.translation
game/locale/*.csv.import
# Ruby / bundler
vendor/bundle/
.bundle/
# Android gradle build template installed by make setup (from export templates)
game/android/build/
game/android/.build_version
# Per-checkout Godot user:// dir for make test/playtest (XDG_DATA_HOME, see Makefile)
.godot-userdata/
